# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit real IPs/keys to source control.

aws_region   = "us-east-1"
environment  = "lab"
project_name = "netlab"

vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.11.0/24", "10.0.12.0/24"]
az_count              = 2
single_nat_gateway    = true   # set false for one NAT per AZ (higher cost, higher availability)

instance_type = "t3.micro"

# Name of an EXISTING EC2 key pair in your account. Leave blank ("") to skip
# SSH key assignment entirely if you plan to use SSM Session Manager instead.
key_pair_name = ""

# IMPORTANT: replace with your actual public IP, e.g. "203.0.113.42/32"
# Find it with: curl ifconfig.me
bastion_allowed_cidr = "0.0.0.0/0"

enable_bastion = true
